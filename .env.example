# Server-only — set in Vercel (Production + Preview). Never prefix with NEXT_PUBLIC_.
SUPABASE_URL=https://swawpzsacylgudxpnjoz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# ≥32 random chars: openssl rand -base64 48
WAITLIST_FORM_SECRET=
# Vercel sends this as a Bearer token on cron runs: openssl rand -base64 32
CRON_SECRET=

# New sign-up emails (optional — skipped if unset). https://resend.com → API Keys
RESEND_API_KEY=
# Who gets the email; comma-separate for several
NOTIFY_EMAIL=
# Optional sender on a domain verified in Resend, e.g. "Moodoo <waitlist@yourdomain.com>".
# Without it Resend's test sender is used, which only delivers to the Resend account's own email.
NOTIFY_FROM=
